+          <button type="button" id="verifyBack" class="auth-link">Voltar</button>
+        </div>
+      </form>
+
+      <p class="auth-error" id="authError" role="alert" hidden></p>
+
+    </div>
+
+  </div>
+
+  <script src="script.js?v=9"></script>
 
 </body>
 
